---
// Step 3 - drop-in header for src/layouts/Base.astro. Dummy brand and links.
const links = [
  { href: "https://www.example.com/", label: "Home" },
  { href: "https://www.example.com/about", label: "About" },
  { href: "/blog/", label: "Blog", current: true },
];
---
<header class="site-header">
  <button type="button" class="nav-toggle" aria-label="Open menu" aria-expanded="false" aria-controls="site-nav">
    <svg class="burger" viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" aria-hidden="true">
      <g transform="translate(12,12)">
        <path class="b1" d="M-9 -5 L9 -5" stroke-width="2" />
        <path class="b2" d="M-9 0 L9 0" stroke-width="2" />
        <path class="b3" d="M-9 5 L9 5" stroke-width="2" />
      </g>
    </svg>
  </button>
  <a class="brand" href="https://www.example.com/">
    <img class="brand__logo" src="/logo.png" alt="" width="40" height="40" />
    <span>Your Site Name</span>
  </a>
  <nav class="site-nav" id="site-nav" aria-label="Main">
    <ul>{links.map((l) => <li><a href={l.href} aria-current={l.current ? "page" : undefined}>{l.label}</a></li>)}</ul>
  </nav>
</header>
<div class="nav-scrim" hidden></div>

<script is:inline>
  (function () {
    var b = document.body, t = document.querySelector(".nav-toggle"), sc = document.querySelector(".nav-scrim");
    sc.hidden = false;
    function set(open) {
      b.classList.toggle("nav-open", open);
      t.setAttribute("aria-expanded", String(open));
      t.setAttribute("aria-label", open ? "Close menu" : "Open menu");
    }
    t.addEventListener("click", function () { set(!b.classList.contains("nav-open")); });
    sc.addEventListener("click", function () { set(false); });
    document.addEventListener("keydown", function (e) { if (e.key === "Escape") set(false); });
  })();
</script>

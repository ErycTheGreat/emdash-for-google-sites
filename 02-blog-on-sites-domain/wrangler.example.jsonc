// What to MERGE into the wrangler.jsonc that `npm create emdash` made for you (part 00).
// Keep your project's own name and D1/R2/KV bindings exactly as generated; add the routes below.
// Replace example.com. No account or zone IDs needed: `npx wrangler login` handles auth.
{
  "name": "my-blog",
  "main": "./src/worker.ts",
  "compatibility_date": "2026-02-24",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [{ "binding": "DB", "database_name": "my-blog" }],
  "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "my-blog-media" }],
  "durable_objects": { "bindings": [{ "name": "EMDASH_ROOMS", "class_name": "EmDashRoom" }] },
  "exports": { "EmDashRoom": { "type": "durable-object", "storage": "sqlite" } },
  // More specific than the Google Sites proxy route (www.example.com/*), so these win.
  "routes": [
    { "pattern": "www.example.com/blog", "zone_name": "example.com" },
    { "pattern": "www.example.com/blog/*", "zone_name": "example.com" },
    { "pattern": "www.example.com/_emdash/*", "zone_name": "example.com" },
    { "pattern": "www.example.com/_astro/*", "zone_name": "example.com" },
    // the blog's own host (optional custom domain)
    { "pattern": "blog.example.com", "custom_domain": true }
  ],
  "triggers": { "crons": ["*/5 * * * *"] }
}
